{
  "extends": "@DashboardPT2/config/tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "bun"
    ],
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "paths": {
      "@DashboardPT2/ui/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.svelte",
    "src/**/*.svelte.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
