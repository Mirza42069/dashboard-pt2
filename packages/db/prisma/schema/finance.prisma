enum OrganizationMembershipRole {
  OWNER
  ADMIN
  ACCOUNTANT
  REVIEWER
  MEMBER
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
  BANK
  CLEARING
}

enum ImportSource {
  BANK_STATEMENT
  ERP
  CSV
  API
  MANUAL
}

enum ImportBatchStatus {
  PENDING
  PROCESSING
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
}

enum TransactionDirection {
  DEBIT
  CREDIT
}

enum ReconciliationStatus {
  DRAFT
  IN_PROGRESS
  READY_FOR_REVIEW
  SUBMITTED
  APPROVED
  COMPLETED
  REOPENED
}

enum MatchGroupStatus {
  PROPOSED
  CONFIRMED
  REJECTED
}

enum MatchItemType {
  STATEMENT
  LEDGER
  ADJUSTMENT
}

enum ReconciliationExceptionType {
  AMOUNT_MISMATCH
  DATE_MISMATCH
  DUPLICATE
  MISSING_COUNTERPART
  INVALID_SOURCE_DATA
  OTHER
}

enum ReconciliationExceptionSeverity {
  INFO
  WARNING
  ERROR
}

enum ReconciliationExceptionStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  IGNORED
}

enum ReconciliationEventType {
  CREATED
  STATUS_CHANGED
  SUBMITTED
  APPROVED
  REOPENED
  IMPORT_METADATA_CREATED
  IMPORT_ATTACHED
  MATCH_CREATED
  MATCH_REMOVED
  EXCEPTION_CREATED
  EXCEPTION_RESOLVED
  COMMENT_ADDED
}

model Organization {
  id               String                    @id @default(cuid())
  name             String
  code             String                    @unique
  defaultCurrency  String                    @default("USD") @db.Char(3)
  timezone         String                    @default("UTC")
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  memberships      OrganizationMembership[]
  legalEntities    LegalEntity[]
  ledgerAccounts   LedgerAccount[]
  reconciliations  Reconciliation[]
  importBatches    ImportBatch[]
  importArtifacts  ImportArtifact[]
  importRows       ImportRow[]
  importCellEdits  ImportCellEdit[]
  validationRuns   ImportValidationRun[]
  validationIssues ImportValidationIssue[]
  transactions     Transaction[]
  matchGroups      MatchGroup[]
  matchItems       MatchItem[]
  exceptions       ReconciliationException[]
  events           ReconciliationEvent[]
  activityLogs     ActivityLog[]
  conversations    Conversation[]
  chatMessages     ChatMessage[]

  @@index([name])
}

model OrganizationMembership {
  id             String                     @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationMembershipRole @default(MEMBER)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
}

model LegalEntity {
  id                 String           @id @default(cuid())
  organizationId     String
  name               String
  code               String
  registrationNumber String?
  baseCurrency       String           @db.Char(3)
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  ledgerAccounts     LedgerAccount[]
  reconciliations    Reconciliation[]
  importBatches      ImportBatch[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@index([organizationId, name])
  @@index([organizationId, isActive])
}

model LedgerAccount {
  id              String            @id @default(cuid())
  organizationId  String
  legalEntityId   String
  code            String
  name            String
  type            LedgerAccountType
  currency        String            @db.Char(3)
  sourceSystem    String?
  externalId      String?
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  legalEntity     LegalEntity       @relation(fields: [organizationId, legalEntityId], references: [organizationId, id], onDelete: Restrict)
  reconciliations Reconciliation[]
  importBatches   ImportBatch[]
  transactions    Transaction[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@unique([organizationId, sourceSystem, externalId])
  @@index([organizationId, legalEntityId])
  @@index([organizationId, type, isActive])
}

model Reconciliation {
  id                String                    @id @default(cuid())
  organizationId    String
  legalEntityId     String
  ledgerAccountId   String
  ownerId           String?
  createdById       String?
  name              String
  currency          String                    @db.Char(3)
  periodStart       DateTime                  @db.Date
  periodEnd         DateTime                  @db.Date
  openingBalance    Decimal                   @default(0) @db.Decimal(20, 4)
  closingBalance    Decimal                   @default(0) @db.Decimal(20, 4)
  statementBalance  Decimal?                  @db.Decimal(20, 4)
  reconciledBalance Decimal?                  @db.Decimal(20, 4)
  status            ReconciliationStatus      @default(DRAFT)
  completedAt       DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  legalEntity       LegalEntity               @relation(fields: [organizationId, legalEntityId], references: [organizationId, id], onDelete: Restrict)
  ledgerAccount     LedgerAccount             @relation(fields: [organizationId, ledgerAccountId], references: [organizationId, id], onDelete: Restrict)
  owner             User?                     @relation("ReconciliationOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy         User?                     @relation("ReconciliationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  importBatches     ImportBatch[]
  transactions      Transaction[]
  matchGroups       MatchGroup[]
  exceptions        ReconciliationException[]
  events            ReconciliationEvent[]

  @@unique([ledgerAccountId, periodStart, periodEnd])
  @@unique([organizationId, id])
  @@index([organizationId, status, periodEnd])
  @@index([organizationId, legalEntityId, periodEnd])
  @@index([ownerId, status])
}

model ImportBatch {
  id               String                @id @default(cuid())
  organizationId   String
  legalEntityId    String
  ledgerAccountId  String?
  reconciliationId String
  createdById      String?
  source           ImportSource
  sourceSystem     String?
  externalBatchId  String?
  originalFilename String?
  contentType      String?
  sizeBytes        BigInt                @default(0)
  contentHash      String?
  sourceMetadata   Json?
  documentType     CoretaxDocumentType?
  rulesetVersion   String?
  configuredSheet  String?
  columnMapping    Json?
  dataVersion      Int                   @default(0)
  status           ImportBatchStatus     @default(PENDING)
  rowCount         Int                   @default(0)
  importedCount    Int                   @default(0)
  rejectedCount    Int                   @default(0)
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  legalEntity      LegalEntity           @relation(fields: [organizationId, legalEntityId], references: [organizationId, id], onDelete: Restrict)
  ledgerAccount    LedgerAccount?        @relation(fields: [organizationId, ledgerAccountId], references: [organizationId, id], onDelete: Restrict)
  reconciliation   Reconciliation        @relation(fields: [organizationId, reconciliationId], references: [organizationId, id], onDelete: Restrict)
  createdBy        User?                 @relation("ImportBatchCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  transactions     Transaction[]
  artifacts        ImportArtifact[]
  rows             ImportRow[]
  validationRuns   ImportValidationRun[]

  @@unique([organizationId, sourceSystem, externalBatchId])
  @@unique([organizationId, id])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, legalEntityId, createdAt])
  @@index([ledgerAccountId, createdAt])
  @@index([organizationId, reconciliationId, createdAt])
}

model Transaction {
  id               String                    @id @default(cuid())
  organizationId   String
  importBatchId    String
  ledgerAccountId  String
  reconciliationId String
  sourceRecordId   String
  sourceLineNumber Int?
  effectiveDate    DateTime                  @db.Date
  postedAt         DateTime?
  amount           Decimal                   @db.Decimal(20, 4)
  currency         String                    @db.Char(3)
  direction        TransactionDirection
  description      String
  reference        String?
  counterparty     String?
  rawData          Json?
  importedAt       DateTime                  @default(now())
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  organization     Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  importBatch      ImportBatch               @relation(fields: [organizationId, importBatchId], references: [organizationId, id], onDelete: Restrict)
  ledgerAccount    LedgerAccount             @relation(fields: [organizationId, ledgerAccountId], references: [organizationId, id], onDelete: Restrict)
  reconciliation   Reconciliation            @relation(fields: [organizationId, reconciliationId], references: [organizationId, id], onDelete: Restrict)
  matchItems       MatchItem[]
  exceptions       ReconciliationException[]

  @@unique([importBatchId, sourceRecordId])
  @@unique([organizationId, id])
  @@index([organizationId, ledgerAccountId, effectiveDate])
  @@index([organizationId, reconciliationId, effectiveDate])
  @@index([organizationId, reference])
  @@index([organizationId, counterparty])
}

model MatchGroup {
  id               String           @id @default(cuid())
  organizationId   String
  reconciliationId String
  createdById      String?
  status           MatchGroupStatus @default(PROPOSED)
  confidence       Decimal?         @db.Decimal(5, 4)
  matchRule        String?
  confirmedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  reconciliation   Reconciliation   @relation(fields: [organizationId, reconciliationId], references: [organizationId, id], onDelete: Restrict)
  createdBy        User?            @relation("MatchGroupCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items            MatchItem[]

  @@unique([organizationId, id])
  @@index([organizationId, reconciliationId, status])
  @@index([createdById, createdAt])
}

model MatchItem {
  id              String        @id @default(cuid())
  organizationId  String
  matchGroupId    String
  transactionId   String
  type            MatchItemType
  allocatedAmount Decimal       @db.Decimal(20, 4)
  createdAt       DateTime      @default(now())
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  matchGroup      MatchGroup    @relation(fields: [organizationId, matchGroupId], references: [organizationId, id], onDelete: Cascade)
  transaction     Transaction   @relation(fields: [organizationId, transactionId], references: [organizationId, id], onDelete: Restrict)

  @@unique([matchGroupId, transactionId])
  @@index([organizationId, transactionId])
}

model ReconciliationException {
  id               String                          @id @default(cuid())
  organizationId   String
  reconciliationId String
  transactionId    String?
  assignedToId     String?
  resolvedById     String?
  type             ReconciliationExceptionType
  severity         ReconciliationExceptionSeverity @default(WARNING)
  status           ReconciliationExceptionStatus   @default(OPEN)
  title            String
  detail           String?
  amount           Decimal?                        @db.Decimal(20, 4)
  resolution       String?
  resolvedAt       DateTime?
  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt
  organization     Organization                    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  reconciliation   Reconciliation                  @relation(fields: [organizationId, reconciliationId], references: [organizationId, id], onDelete: Restrict)
  transaction      Transaction?                    @relation(fields: [organizationId, transactionId], references: [organizationId, id], onDelete: Restrict)
  assignedTo       User?                           @relation("ExceptionAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolvedBy       User?                           @relation("ExceptionResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status, severity])
  @@index([reconciliationId, status])
  @@index([assignedToId, status])
  @@index([transactionId])
}

model ReconciliationEvent {
  id               String                  @id @default(cuid())
  organizationId   String
  reconciliationId String
  actorId          String?
  type             ReconciliationEventType
  fromStatus       ReconciliationStatus?
  toStatus         ReconciliationStatus?
  payload          Json?
  occurredAt       DateTime                @default(now())
  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  reconciliation   Reconciliation          @relation(fields: [organizationId, reconciliationId], references: [organizationId, id], onDelete: Restrict)
  actor            User?                   @relation("ReconciliationEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, reconciliationId, occurredAt])
  @@index([actorId, occurredAt])
}

model ActivityLog {
  id             String       @id @default(cuid())
  organizationId String
  actorId        String?
  action         String
  resourceType   String
  resourceId     String?
  correlationId  String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  occurredAt     DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor          User?        @relation("ActivityLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt])
  @@index([organizationId, resourceType, resourceId])
  @@index([actorId, occurredAt])
  @@index([correlationId])
}
