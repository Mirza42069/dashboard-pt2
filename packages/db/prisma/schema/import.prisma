enum CoretaxDocumentType {
  FAKTUR_KELUARAN
  BPPU
}

enum ImportArtifactKind {
  ORIGINAL_FILE
  CORETAX_XML
}

enum ImportValidationStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum ImportValidationSeverity {
  INFO
  WARNING
  ERROR
}

model ImportArtifact {
  id               String               @id @default(cuid())
  organizationId   String
  importBatchId    String
  validationRunId  String?
  createdById      String?
  kind             ImportArtifactKind
  version          Int
  inputDataVersion Int
  fileName         String
  contentType      String
  sizeBytes        BigInt
  sha256           String
  objectPath       String               @unique
  etag             String?
  createdAt        DateTime             @default(now())
  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  importBatch      ImportBatch          @relation(fields: [organizationId, importBatchId], references: [organizationId, id], onDelete: Restrict)
  validationRun    ImportValidationRun? @relation(fields: [organizationId, importBatchId, validationRunId], references: [organizationId, importBatchId, id], onDelete: Restrict)
  createdBy        User?                @relation("ImportArtifactCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([organizationId, id])
  @@unique([importBatchId, kind, version])
  @@unique([importBatchId, kind, inputDataVersion])
  @@index([organizationId, importBatchId, kind, createdAt])
}

model ImportRow {
  id               String                  @id @default(cuid())
  organizationId   String
  importBatchId    String
  sourceLocator    String
  sourceSheet      String?
  sourceRowNumber  Int?
  sortOrder        Int
  rawData          Json
  normalizedData   Json
  version          Int                     @default(0)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  importBatch      ImportBatch             @relation(fields: [organizationId, importBatchId], references: [organizationId, id], onDelete: Restrict)
  edits            ImportCellEdit[]
  validationIssues ImportValidationIssue[]

  @@unique([organizationId, id])
  @@unique([organizationId, importBatchId, id])
  @@unique([importBatchId, sourceLocator])
  @@index([organizationId, importBatchId, sortOrder])
}

model ImportCellEdit {
  id                 String       @id @default(cuid())
  organizationId     String
  importBatchId      String
  importRowId        String
  editedById         String?
  fieldKey           String
  previousValue      Json
  newValue           Json
  previousRowVersion Int
  rowVersion         Int
  batchDataVersion   Int
  editedAt           DateTime     @default(now())
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  importRow          ImportRow    @relation(fields: [organizationId, importBatchId, importRowId], references: [organizationId, importBatchId, id], onDelete: Restrict)
  editedBy           User?        @relation("ImportCellEditActor", fields: [editedById], references: [id], onDelete: SetNull)

  @@unique([importRowId, rowVersion])
  @@index([organizationId, importBatchId, editedAt])
  @@index([editedById, editedAt])
}

model ImportValidationRun {
  id               String                  @id @default(cuid())
  organizationId   String
  importBatchId    String
  requestedById    String?
  inputDataVersion Int
  ruleset          CoretaxDocumentType
  rulesetVersion   String
  status           ImportValidationStatus  @default(PROCESSING)
  errorCount       Int                     @default(0)
  warningCount     Int                     @default(0)
  infoCount        Int                     @default(0)
  failureCode      String?
  summary          Json?
  startedAt        DateTime                @default(now())
  completedAt      DateTime?
  createdAt        DateTime                @default(now())
  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  importBatch      ImportBatch             @relation(fields: [organizationId, importBatchId], references: [organizationId, id], onDelete: Restrict)
  requestedBy      User?                   @relation("ImportValidationRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  issues           ImportValidationIssue[]
  artifacts        ImportArtifact[]

  @@unique([organizationId, id])
  @@unique([organizationId, importBatchId, id])
  @@index([organizationId, importBatchId, createdAt])
}

model ImportValidationIssue {
  id              String                   @id @default(cuid())
  organizationId  String
  importBatchId   String
  validationRunId String
  importRowId     String?
  severity        ImportValidationSeverity
  code            String
  fieldKey        String?
  parameters      Json?
  invalidValue    Json?
  createdAt       DateTime                 @default(now())
  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  validationRun   ImportValidationRun      @relation(fields: [organizationId, importBatchId, validationRunId], references: [organizationId, importBatchId, id], onDelete: Restrict)
  importRow       ImportRow?               @relation(fields: [organizationId, importBatchId, importRowId], references: [organizationId, importBatchId, id], onDelete: Restrict)

  @@index([organizationId, importBatchId, validationRunId, severity])
  @@index([organizationId, importRowId, fieldKey])
}
