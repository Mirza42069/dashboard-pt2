/// Who produced a turn. There is no SYSTEM role: this product has no system
/// prompt a reader could ever see, and a role nobody renders is a role that
/// rots.
enum ChatRole {
  USER
  AGENT
}

/// One thread of work with the agent.
///
/// Scoped to the organization *and* to a user, unlike everything in
/// finance.prisma. A reconciliation belongs to the company and any member with
/// the right role may act on it; a conversation is the record of one person
/// asking for something, and showing it to a colleague would be a surprise.
model Conversation {
  id             String        @id @default(cuid())
  organizationId String
  userId         String
  /// Taken from the opening turn and editable afterwards. Stored rather than
  /// derived so renaming a thread survives, and so the history list does not
  /// have to load a message to draw a row.
  title          String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User          @relation("ConversationUser", fields: [userId], references: [id], onDelete: Cascade)
  messages       ChatMessage[]

  /// The compound target every child references, so a cross-tenant foreign key
  /// is a database error rather than an application bug — the same rule every
  /// model in finance.prisma follows.
  @@unique([organizationId, id])
  /// The history list: this user's threads, most recently touched first.
  @@index([organizationId, userId, updatedAt])
}

/// One turn in a thread.
///
/// `body` is structured, never prose. A USER turn holds `{ text, attachments }`;
/// an AGENT turn holds an intent, its parameters, the step timeline and an
/// optional result payload — and the client renders every visible word from the
/// dictionary. That is what lets an old thread switch language, and it is the
/// same arrangement ActivityLog already relies on.
model ChatMessage {
  id             String       @id @default(cuid())
  organizationId String
  conversationId String
  role           ChatRole
  body           Json
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  conversation   Conversation @relation(fields: [organizationId, conversationId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, id])
  /// Reading a thread in order, which is the only way a turn is ever fetched.
  @@index([organizationId, conversationId, createdAt])
}
