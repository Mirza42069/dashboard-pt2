# Set runtime values in the Convex deployment environment, not in frontend env.
# Local CLI configuration (choose a real deployment during setup):
CONVEX_DEPLOYMENT=
CONVEX_URL=
CONVEX_SITE_URL=

# Application origin and a generated authentication secret:
SITE_URL=http://localhost:5173
BETTER_AUTH_SECRET=

# Optional Google sign-in:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Platform secret with permission to transact on verified XenPlatform accounts.
# Never expose these keys through VITE_, PUBLIC_, or NEXT_PUBLIC_ variables.
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
