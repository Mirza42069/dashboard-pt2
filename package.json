{
  "name": "DashboardPT2",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "svelte": "^5.56.8",
      "svelte-check": "^4.7.4",
      "tailwindcss": "^4.3.3",
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6.0.3",
      "@types/node": "^26.2.0",
      "@prisma/client": "^7.9.1",
      "@orpc/server": "^1.14.12",
      "@orpc/client": "^1.14.12",
      "@orpc/openapi": "^1.14.12",
      "@orpc/zod": "^1.14.12",
      "better-auth": "1.7.1"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "db:push": "turbo run db:push -F @DashboardPT2/db --",
    "db:studio": "turbo run db:studio -F @DashboardPT2/db --",
    "db:generate": "turbo run db:generate -F @DashboardPT2/db --",
    "db:migrate": "turbo run db:migrate -F @DashboardPT2/db --",
    "db:seed-admin": "tsx scripts/seed-admin.ts",
    "deploy:setup": "vercel link",
    "dev:vercel": "vercel dev -L",
    "env:preview": "tsx scripts/sync-vercel-env.ts preview",
    "env:production": "tsx scripts/sync-vercel-env.ts production",
    "deploy": "vercel deploy",
    "deploy:prod": "vercel deploy --prod",
    "deploy:check": "vercel deploy --dry"
  },
  "dependencies": {
    "@DashboardPT2/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@DashboardPT2/config": "workspace:*",
    "@types/node": "catalog:",
    "tsx": "^4.23.1",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "vercel": "^58.1.0"
  },
  "packageManager": "bun@1.3.6"
}
