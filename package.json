{
  "name": "DashboardPT2",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "svelte": "^5.56.8",
      "svelte-check": "^4.7.4",
      "tailwindcss": "^4.3.3",
      "typescript": "^6.0.3",
      "@types/node": "^26.2.0"
    }
  },
  "scripts": {
    "dev": "bun run --cwd apps/addin dev",
    "build": "bun run --cwd apps/addin build",
    "check-types": "bun run --cwd apps/addin check-types",
    "validate": "bun run check-types && bun run build"
  },
  "packageManager": "bun@1.3.6"
}
