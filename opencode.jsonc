{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    // Official Svelte MCP: docs lookup + static analysis that flags common
    // Svelte 5 / SvelteKit mistakes. Use it before writing Svelte code.
    "svelte": {
      "type": "local",
      "command": ["bunx", "-y", "@sveltejs/mcp"],
      "enabled": true,
      "environment": {}
    },
    // Up-to-date library docs for Effect TS (and anything else). No official
    // Effect MCP exists, so Context7 fills that gap.
    "context7": {
      "type": "local",
      "command": ["bunx", "-y", "@upstash/context7-mcp"],
      "enabled": true,
      "environment": {}
    }
  },
  "references": {
    // Effect TS source at your fingertips with @effect.
    "effect": {
      "repository": "Effect-TS/effect",
      "branch": "main",
      "description": "Use for Effect TS APIs, modules, and implementation details"
    }
  }
}
